# ===== Provider API Keys =====
# Điền key của provider bạn muốn dùng, để trống nếu không dùng

# Google Gemini (free tier tại https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenRouter (https://openrouter.ai/keys) — hỗ trợ nhiều model miễn phí
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Provider mặc định: gemini | openai | anthropic | openrouter
ACTIVE_PROVIDER=gemini
